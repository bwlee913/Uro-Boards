# ============================================================
#  URO BOARDS — Environment Variables
#  Copy this to .env.local for local dev (never commit .env.local)
#  Add these to Vercel dashboard for production
# ============================================================

# ── Anthropic (required for AI question generation) ──────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Firebase (optional — enables shared leaderboard + push notifications) ──
# Get these from your Firebase project settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging — VAPID key for push notifications
# Found in Firebase console > Project settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
